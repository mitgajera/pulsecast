FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY services/oracle-collector/package.json services/oracle-collector/package.json

RUN npm ci --omit=dev --workspace=@pulsecast/oracle-collector --include-workspace-root=false \
    && npm cache clean --force

COPY tsconfig.base.json ./tsconfig.base.json
COPY packages/shared/src packages/shared/src
COPY services/oracle-collector/src services/oracle-collector/src
COPY services/oracle-collector/tsconfig.json services/oracle-collector/tsconfig.json

USER node
EXPOSE 10000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --quiet --tries=1 --spider "http://127.0.0.1:${PORT:-10000}/health" || exit 1

CMD ["npm", "run", "start", "--workspace=@pulsecast/oracle-collector"]

